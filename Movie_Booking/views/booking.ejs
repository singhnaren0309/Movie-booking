<%- include('partials/header') %>

<div style="margin-bottom: 2rem;">
    <a href="/movies/<%= show.movieId._id %>" style="color:var(--text-secondary); font-size:0.9rem;">&larr; Back to Showtimes</a>
    <h1 style="font-family:'Outfit',sans-serif; font-size:2rem; margin-top:0.5rem;"><%= show.movieId.name %></h1>
    <p style="color:var(--text-muted); font-size:0.95rem;">
        <%= show.theatreId.name %> &bull; <%= show.timing %> &bull; <%= show.format || 'STANDARD' %> &bull; ₹<%= show.price %> per ticket
    </p>
</div>

<div class="screen-wrap">
    <div class="screen-curve"></div>
    <div class="screen-text">ALL EYES THIS WAY • SCREEN</div>
</div>

<div class="seats-legend">
    <div class="legend-item">
        <div class="legend-box" style="background:#1e293b; border:1px solid rgba(255,255,255,0.1);"></div>
        <span>Available</span>
    </div>
    <div class="legend-item">
        <div class="legend-box" style="background:var(--accent);"></div>
        <span>Selected</span>
    </div>
    <div class="legend-item">
        <div class="legend-box" style="background:#0b0f19;"></div>
        <span>Occupied</span>
    </div>
</div>

<div class="seats-grid-wrap" id="seats-container">
    <!-- Generated by JS -->
</div>

<div class="booking-checkout-bar">
    <div>
        <div style="font-size:0.85rem; color:var(--text-muted);">Selected Seats</div>
        <div id="selected-seats-display" style="font-size:1.1rem; font-weight:700; color:var(--text-primary);">None</div>
    </div>
    <div>
        <div style="font-size:0.85rem; color:var(--text-muted);">Total Price</div>
        <div id="total-price-display" style="font-size:1.4rem; font-weight:800; color:var(--accent-gold);">₹0</div>
    </div>
    <div>
        <button id="proceed-btn" class="btn btn-primary" disabled>
            Proceed to Payment
        </button>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
    const showPrice = <%= show.price %>;
    const availableCount = <%= show.noOfSeats %>;
    const theatreId = "<%= show.theatreId._id %>";
    const movieId = "<%= show.movieId._id %>";
    const timing = "<%= show.timing %>";
    const showId = "<%= show._id %>";

    const seatsContainer = document.getElementById("seats-container");
    const selectedSeatsDisplay = document.getElementById("selected-seats-display");
    const totalPriceDisplay = document.getElementById("total-price-display");
    const proceedBtn = document.getElementById("proceed-btn");

    const rows = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'];
    const cols = 10;
    const selectedSeats = new Set();

    let seatCounter = 0;
    rows.forEach(row => {
        const rowDiv = document.createElement("div");
        rowDiv.className = "seat-row";

        for (let col = 1; col <= cols; col++) {
            seatCounter++;
            const seatId = `${row}${col}`;
            const seat = document.createElement("div");
            seat.className = "seat-item";
            seat.textContent = seatId;
            seat.dataset.seat = seatId;

            if (seatCounter > availableCount) {
                seat.classList.add("occupied");
            } else {
                seat.classList.add("available");
                seat.addEventListener("click", () => {
                    if (selectedSeats.has(seatId)) {
                        selectedSeats.delete(seatId);
                        seat.classList.remove("selected");
                    } else {
                        selectedSeats.add(seatId);
                        seat.classList.add("selected");
                    }
                    updateCheckout();
                });
            }
            rowDiv.appendChild(seat);
        }
        seatsContainer.appendChild(rowDiv);
    });

    function updateCheckout() {
        const count = selectedSeats.size;
        if (count > 0) {
            selectedSeatsDisplay.textContent = Array.from(selectedSeats).join(", ") + ` (${count})`;
            const total = count * showPrice;
            totalPriceDisplay.textContent = `₹${total}`;
            proceedBtn.disabled = false;
        } else {
            selectedSeatsDisplay.textContent = "None";
            totalPriceDisplay.textContent = "₹0";
            proceedBtn.disabled = true;
        }
    }

    proceedBtn.addEventListener("click", async () => {
        const token = Auth.getToken();
        if (!token) {
            showToast("Please sign in to proceed with booking", "error");
            setTimeout(() => {
                window.location.href = `/signin?redirect=/booking/${showId}`;
            }, 1000);
            return;
        }

        proceedBtn.disabled = true;
        proceedBtn.textContent = "Reserving seats...";

        try {
            const res = await fetch("/mba/api/v1/bookings", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "x-access-token": token
                },
                body: JSON.stringify({
                    theatreId: theatreId,
                    movieId: movieId,
                    timing: timing,
                    noOfSeats: selectedSeats.size
                })
            });

            const data = await res.json();
            if (res.status === 201 && data.data && data.data._id) {
                showToast("Seats reserved! Redirecting to checkout...", "success");
                setTimeout(() => {
                    window.location.href = `/payment/${data.data._id}`;
                }, 800);
            } else {
                showToast(data.err || data.message || "Booking failed", "error");
                proceedBtn.disabled = false;
                proceedBtn.textContent = "Proceed to Payment";
            }
        } catch (err) {
            showToast("Network error creating booking", "error");
            proceedBtn.disabled = false;
            proceedBtn.textContent = "Proceed to Payment";
        }
    });
});
</script>

<%- include('partials/footer') %>
