<%- include('partials/header') %>

<section class="hero">
    <div class="hero-tag">🔥 Now In Theatres</div>
    <h1>Experience Cinema <br>Like Never Before.</h1>
    <p>Browse the latest blockbuster movies, find theatres near you, pick your favorite seats in real-time, and get instant digital tickets with email notifications.</p>
    <div style="display: flex; gap: 1rem; margin-top: 0.5rem;">
        <a href="#now-showing" class="btn btn-primary">Browse Movies</a>
        <a href="/my-bookings" class="btn btn-secondary">My Tickets</a>
    </div>
</section>

<section id="now-showing">
    <div class="section-header">
        <h2 class="section-title">Now Showing</h2>
        <span style="font-size:0.9rem; color:var(--text-muted);"><%= nowShowing.length %> Movies Available</span>
    </div>

    <% if (nowShowing && nowShowing.length > 0) { %>
        <div class="movie-grid">
            <% nowShowing.forEach(movie => { %>
                <div class="movie-card">
                    <div class="movie-poster-wrap">
                        <% if (movie.trailerUrl && movie.trailerUrl.startsWith('http')) { %>
                            <img src="<%= movie.trailerUrl %>" alt="<%= movie.name %> Poster" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                            <div class="poster-fallback" style="display:none;">
                                🎬
                                <p><%= movie.name %></p>
                            </div>
                        <% } else { %>
                            <div class="poster-fallback">
                                🎬
                                <p><%= movie.name %></p>
                            </div>
                        <% } %>
                        <span class="status-badge released"><%= movie.language || 'English' %></span>
                    </div>
                    <div class="movie-info">
                        <h3 class="movie-title"><%= movie.name %></h3>
                        <div class="movie-meta">
                            <span>Director: <%= movie.director || 'N/A' %></span>
                        </div>
                        <p style="font-size:0.85rem; color:var(--text-secondary); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                            <%= movie.description %>
                        </p>
                        <a href="/movies/<%= movie._id %>" class="btn btn-primary btn-block btn-sm" style="margin-top:1rem;">
                            View Shows & Book
                        </a>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div style="padding: 3rem; text-align: center; background: var(--bg-card); border-radius: var(--radius-md); border: 1px solid var(--border);">
            <p style="color: var(--text-secondary); font-size: 1.1rem;">No movies currently playing. Check back soon!</p>
        </div>
    <% } %>
</section>

<% if (upcoming && upcoming.length > 0) { %>
<section style="margin-top: 2rem;">
    <div class="section-header">
        <h2 class="section-title">Coming Soon</h2>
        <span style="font-size:0.9rem; color:var(--text-muted);"><%= upcoming.length %> Upcoming</span>
    </div>
    <div class="movie-grid">
        <% upcoming.forEach(movie => { %>
            <div class="movie-card">
                <div class="movie-poster-wrap">
                    <div class="poster-fallback">
                        🎞️
                        <p><%= movie.name %></p>
                    </div>
                    <span class="status-badge unreleased">Coming Soon</span>
                </div>
                <div class="movie-info">
                    <h3 class="movie-title"><%= movie.name %></h3>
                    <div class="movie-meta">
                        <span>Release: <%= movie.release_date || 'TBA' %></span>
                    </div>
                    <p style="font-size:0.85rem; color:var(--text-secondary); display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden;">
                        <%= movie.description %>
                    </p>
                </div>
            </div>
        <% }); %>
    </div>
</section>
<% } %>

<%- include('partials/footer') %>
