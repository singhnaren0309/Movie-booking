<%- include('partials/header') %>

<div class="movie-hero-detail">
    <div class="detail-poster">
        <% if (movie.trailerUrl && movie.trailerUrl.startsWith('http')) { %>
            <img src="<%= movie.trailerUrl %>" alt="<%= movie.name %>" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div class="poster-fallback" style="display:none; height:100%;">
                🎬
                <p><%= movie.name %></p>
            </div>
        <% } else { %>
            <div class="poster-fallback" style="height:100%;">
                🎬
                <p><%= movie.name %></p>
            </div>
        <% } %>
    </div>
    <div class="detail-info">
        <div class="detail-tags">
            <span class="tag-badge" style="color:#10b981;"><%= movie.release_status || 'Now Showing' %></span>
            <span class="tag-badge"><%= movie.language || 'English' %></span>
        </div>
        <h1 class="detail-title"><%= movie.name %></h1>
        <p class="detail-desc"><%= movie.description %></p>

        <div class="detail-metadata-grid">
            <div class="metadata-item">
                <h4>Director</h4>
                <p><%= movie.director || 'N/A' %></p>
            </div>
            <div class="metadata-item">
                <h4>Release Date</h4>
                <p><%= movie.release_date || 'N/A' %></p>
            </div>
            <div class="metadata-item" style="grid-column: span 2;">
                <h4>Starring Cast</h4>
                <p><%= (movie.casts && Array.isArray(movie.casts)) ? movie.casts.join(', ') : 'N/A' %></p>
            </div>
        </div>
    </div>
</div>

<section>
    <div class="section-header">
        <h2 class="section-title">Select Theatre & Show Timing</h2>
    </div>

    <% if (theatresList && theatresList.length > 0) { %>
        <% theatresList.forEach(item => { %>
            <div class="theatre-card">
                <div class="theatre-header">
                    <div>
                        <h3 class="theatre-name">🏛️ <%= item.theatre.name %></h3>
                        <p class="theatre-location"><%= item.theatre.address || '' %> <%= item.theatre.city ? '• ' + item.theatre.city : '' %></p>
                    </div>
                </div>
                <div class="shows-row">
                    <% item.shows.forEach(show => { %>
                        <a href="/booking/<%= show._id %>" class="show-pill">
                            <span class="show-time"><%= show.timing %></span>
                            <span class="show-format"><%= show.format || 'STANDARD' %></span>
                            <span class="show-price">₹<%= show.price %> • <%= show.noOfSeats %> seats</span>
                        </a>
                    <% }); %>
                </div>
            </div>
        <% }); %>
    <% } else { %>
        <div style="padding: 3rem; text-align: center; background: var(--bg-card); border-radius: var(--radius-md); border: 1px solid var(--border);">
            <p style="color: var(--text-secondary); font-size: 1.1rem;">No shows are currently scheduled for this movie. Please check back later!</p>
            <a href="/" class="btn btn-secondary" style="margin-top: 1rem;">Back to Movies</a>
        </div>
    <% } %>
</section>

<%- include('partials/footer') %>
