<%- include('partials/header') %>

<div class="section-header">
    <h2 class="section-title">My Bookings & Tickets</h2>
</div>

<div id="bookings-loading" style="text-align: center; padding: 3rem; color: var(--text-muted);">
    Loading your bookings...
</div>

<div id="bookings-unauth" style="display: none; text-align: center; padding: 3rem; background: var(--bg-card); border-radius: var(--radius-md); border: 1px solid var(--border);">
    <p style="color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 1.2rem;">Please sign in to view your booked tickets.</p>
    <a href="/signin?redirect=/my-bookings" class="btn btn-primary">Sign In</a>
</div>

<div id="bookings-empty" style="display: none; text-align: center; padding: 3rem; background: var(--bg-card); border-radius: var(--radius-md); border: 1px solid var(--border);">
    <p style="color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 1.2rem;">You don't have any bookings yet.</p>
    <a href="/" class="btn btn-primary">Browse Movies</a>
</div>

<div id="bookings-container" style="display: none; display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Populated by JS -->
</div>

<script>
document.addEventListener("DOMContentLoaded", async () => {
    const token = Auth.getToken();
    const loadingDiv = document.getElementById("bookings-loading");
    const unauthDiv = document.getElementById("bookings-unauth");
    const emptyDiv = document.getElementById("bookings-empty");
    const container = document.getElementById("bookings-container");

    if (!token) {
        loadingDiv.style.display = "none";
        unauthDiv.style.display = "block";
        return;
    }

    try {
        const res = await fetch("/mba/api/v1/bookings", {
            headers: { "x-access-token": token }
        });
        const data = await res.json();
        loadingDiv.style.display = "none";

        const bookings = data.data || [];
        if (!Array.isArray(bookings) || bookings.length === 0) {
            emptyDiv.style.display = "block";
            return;
        }

        container.style.display = "flex";
        container.innerHTML = "";

        bookings.reverse().forEach(b => {
            const card = document.createElement("div");
            card.className = "theatre-card";
            card.style.display = "flex";
            card.style.justifyContent = "space-between";
            card.style.alignItems = "center";
            card.style.flexWrap = "wrap";
            card.style.gap = "1rem";

            const isSuccess = b.status === "SUCCESSFUL" || b.status === "SUCCESS";
            const isCancelled = b.status === "CANCELLED";
            const badgeColor = isSuccess ? "#10b981" : (isCancelled ? "#ef4444" : "#f59e0b");

            card.innerHTML = `
                <div>
                    <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.2rem;">Booking ID: ${b._id}</div>
                    <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff;">Timing: ${b.timing}</h3>
                    <p style="color: var(--text-secondary); font-size: 0.9rem; margin-top: 0.3rem;">
                        Seats: <strong>${b.noOfSeats}</strong> &bull; Total: <strong style="color: var(--accent-gold);">₹${b.totalCost}</strong>
                    </p>
                </div>
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <span style="font-size: 0.85rem; font-weight: 700; color: ${badgeColor}; padding: 0.35rem 0.8rem; border-radius: 999px; background: rgba(255,255,255,0.05); border: 1px solid ${badgeColor};">
                        ${b.status}
                    </span>
                    ${b.status === "PROCESSING" ? `
                        <a href="/payment/${b._id}" class="btn btn-primary btn-sm">Pay Now</a>
                    ` : ''}
                    ${b.status === "PROCESSING" ? `
                        <button onclick="cancelBooking('${b._id}')" class="btn btn-secondary btn-sm" style="color:#ef4444;">Cancel</button>
                    ` : ''}
                </div>
            `;
            container.appendChild(card);
        });

    } catch (err) {
        loadingDiv.style.display = "none";
        showToast("Error loading your bookings", "error");
    }
});

async function cancelBooking(id) {
    if (!confirm("Are you sure you want to cancel this booking?")) return;
    const token = Auth.getToken();
    try {
        const res = await fetch(`/mba/api/v1/bookings/${id}`, {
            method: "PATCH",
            headers: {
                "Content-Type": "application/json",
                "x-access-token": token
            },
            body: JSON.stringify({ status: "CANCELLED" })
        });
        const data = await res.json();
        if (res.ok) {
            showToast("Booking cancelled successfully", "success");
            setTimeout(() => window.location.reload(), 800);
        } else {
            showToast(data.err || "Cancellation failed", "error");
        }
    } catch (e) {
        showToast("Error cancelling booking", "error");
    }
}
</script>

<%- include('partials/footer') %>
