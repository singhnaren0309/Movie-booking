{
  "name": "cinepass-microservices",
  "version": "1.0.0",
  "description": "Distributed AI-Powered Movie Ticketing Platform with Kafka, Redis locks, Vector Search, and Groq Agentic AI",
  "main": "Movie_Booking/index.js",
  "scripts": {
    "install:all": "npm --prefix Movie_Booking install && npm --prefix NotificationService install && npm --prefix AIService install",
    "start:booking": "npm --prefix Movie_Booking start",
    "start:notification": "npm --prefix NotificationService start",
    "start:ai": "node AIService/server.js",
    "dev:booking": "npm --prefix Movie_Booking run dev",
    "dev:notification": "npm --prefix NotificationService run dev",
    "dev:ai": "npm --prefix AIService run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singhnaren0309/Movie-booking.git"
